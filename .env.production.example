# ==============================================================================
# VATTARA VOICE ASSISTANCE - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env.production' on your production host and populate all
# required credentials. Never commit '.env.production' to version control.
# ==============================================================================

# Core Application Settings
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
PROJECT_NAME="Vattara Voice Assistance"
API_V1_STR=/api/v1
PUBLIC_BASE_URL=https://api.vattara.com

# Cryptographic Security
# CRITICAL: Must be a random hex string at least 32 characters long.
# Generate with: openssl rand -hex 32
SECRET_KEY=replace_with_a_cryptographically_secure_random_64_character_key_now
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Super Admin Initial Provisioning Credentials
# If provided, bootstrap will create or verify this superadmin account upon initial startup.
# Password must be at least 12 characters.
FIRST_SUPERUSER_EMAIL=superadmin@vattara.com
FIRST_SUPERUSER_PASSWORD=replace_with_a_strong_production_master_password!2026

# Production PostgreSQL Database
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=vattara_user
POSTGRES_PASSWORD=replace_with_a_strong_database_password_here
POSTGRES_DB=vattara_production
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30
DB_POOL_PRE_PING=true

# Redis Cache & Background Tasks
REDIS_URL=redis://redis:6379/0

# API Rate Limiting Thresholds
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_FORGOT_PASSWORD_PER_MINUTE=3
RATE_LIMIT_RESET_PASSWORD_PER_MINUTE=5

# CORS Allowed Origins (Comma-separated)
BACKEND_CORS_ORIGINS=["https://app.vattara.com","https://admin.vattara.com"]

# ------------------------------------------------------------------------------
# TELEPHONY PROVIDER (Plivo Programmable Voice - Primary Indian Carrier)
# ------------------------------------------------------------------------------
PLIVO_AUTH_ID=your_live_plivo_auth_id
PLIVO_AUTH_TOKEN=your_live_plivo_auth_token
PLIVO_PHONE_NUMBER=+918040001234
PLIVO_APP_ID=your_plivo_application_id

# ------------------------------------------------------------------------------
# AI CONVERSATIONAL, STT & TTS ENGINES
# ------------------------------------------------------------------------------

# Primary LLM Conversational Provider ("openai", "gemini", or "mock")
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.2
OPENAI_API_KEY=sk-proj-your_live_openai_api_key_here
GEMINI_API_KEY=your_live_gemini_api_key_here
ENABLE_TANGLISH=true

# Speech-to-Text (STT) Provider ("deepgram", "whisper", or "mock")
# Deepgram Nova-2 is recommended for ultra-low latency (<200ms) Tamil & English streaming
STT_PROVIDER=sarvam
SARVAM_STT_MODEL=saaras:v4
SARVAM_STT_LANGUAGE=auto
SARVAM_STT_ENCODING=mulaw
SARVAM_STT_SAMPLE_RATE=8000
DEEPGRAM_API_KEY=your_live_deepgram_api_key_here

# Text-to-Speech (TTS) Provider ("sarvam", "elevenlabs", "openai", or "mock")
# Sarvam AI Bulbul v4 Flash is primary for natural Indian languages (Tamil, English, Tanglish)
TTS_PROVIDER=sarvam
SARVAM_API_KEY=your_live_sarvam_api_key_here
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_TAMIL_SPEAKER=gokul_ta_narration
SARVAM_ENGLISH_SPEAKER=shubh_en_narration_gentle
SARVAM_TELUGU_SPEAKER=tarun_te_narration

# ElevenLabs (Optional Fallback TTS Provider)
ELEVENLABS_API_KEY=your_live_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Real-Time Voice Activity Detection & Audio Streaming
ENABLE_BARGE_IN=true
VAD_ENERGY_THRESHOLD=300.0
VAD_SILENCE_TIMEOUT_MS=800
STREAM_CHUNK_SIZE_BYTES=160
