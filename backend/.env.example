# ==============================================================================
# AI Voice Assistant - Backend Environment Configuration Example
# Copy this file to .env and customize values for your local or production environment:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Application Settings
# ------------------------------------------------------------------------------
PROJECT_NAME="AI Voice Assistant"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"
API_V1_STR="/api/v1"

# ------------------------------------------------------------------------------
# CORS Configuration (JSON array or comma-separated list of origins)
# ------------------------------------------------------------------------------
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# ------------------------------------------------------------------------------
# PostgreSQL Database Settings
# ------------------------------------------------------------------------------
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_secure_password"
POSTGRES_DB="ai_voice_assistant"

# Optional: Directly provide a full database connection URL.
# If left empty, SQLALCHEMY_DATABASE_URI is automatically constructed from the POSTGRES_* variables above:
# postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@<POSTGRES_SERVER>:<POSTGRES_PORT>/<POSTGRES_DB>
# Example for local development / testing fallback:
# SQLALCHEMY_DATABASE_URI="postgresql://postgres:postgres_secure_password@localhost:5432/ai_voice_assistant"
SQLALCHEMY_DATABASE_URI=

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_PRE_PING=true

# ------------------------------------------------------------------------------
# Security & JWT Authentication (Architecture Placeholder for Upcoming Phase)
# ------------------------------------------------------------------------------
# Generate a secure key in production with: openssl rand -hex 32
SECRET_KEY="generate-a-secure-random-secret-key-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# Plivo Programmable Voice Settings (Exclusive Telephony Provider)
# ------------------------------------------------------------------------------
PLIVO_AUTH_ID="your_plivo_auth_id"
PLIVO_AUTH_TOKEN="your_plivo_auth_token"
PLIVO_PHONE_NUMBER="+918040001234"
PLIVO_APP_ID="your_plivo_app_id"
PUBLIC_BASE_URL="https://your-public-domain.com"

# ------------------------------------------------------------------------------
# AI Conversational, STT & TTS Settings
# ------------------------------------------------------------------------------
AI_PROVIDER="gemini"
AI_MODEL="gemini-3.1-flash-lite"
AI_TEMPERATURE=0.2
GEMINI_API_KEY="your_gemini_api_key"
OPENAI_API_KEY="sk-proj-your_openai_api_key"
ENABLE_TANGLISH=true

STT_PROVIDER="deepgram"
DEEPGRAM_API_KEY="your_deepgram_api_key"
DEEPGRAM_MODEL="nova-3"

TTS_PROVIDER="sarvam"
SARVAM_API_KEY="your_sarvam_api_key"
SARVAM_TTS_MODEL="bulbul:v4-flash"
SARVAM_VOICE_ID="gokul_ta_narration"
SARVAM_TAMIL_SPEAKER="gokul_ta_narration"
SARVAM_ENGLISH_SPEAKER="ishita_en_customer"
SARVAM_TELUGU_SPEAKER="kavitha_te_conversation"

# ElevenLabs (Optional Fallback TTS Provider)
ELEVENLABS_API_KEY="your_elevenlabs_api_key"
ELEVENLABS_VOICE_ID="EXAVITQu4vr4xnSDxMaL"
